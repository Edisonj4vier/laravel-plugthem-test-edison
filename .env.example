# ============================================
# APLICACIÓN
# ============================================
APP_NAME="Laravel Survey API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# BASE DE DATOS (MYSQL - REQUERIDO)
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plugthem_exam
DB_USERNAME=root
DB_PASSWORD=

# Nota: SQLite está deshabilitado. Este proyecto requiere MySQL 8.0+
# Si prefieres usar SQLite para desarrollo local rápido, cambia:
# DB_CONNECTION=sqlite
# y comenta las líneas de MySQL arriba

# ============================================
# SESIONES
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================
# BROADCASTING & FILESYSTEM
# ============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ============================================
# CACHE (REDIS - BONUS IMPLEMENTADO)
# ============================================
# Para usar Redis Cache (Bonus):
CACHE_STORE=redis
CACHE_PREFIX=

# Para desarrollo sin Redis, usa:
# CACHE_STORE=file

# ============================================
# REDIS (REQUERIDO PARA BONUS)
# ============================================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Nota: Asegúrate de tener Redis instalado y corriendo
# Verifica con: redis-cli ping (debe responder PONG)
# Si no tienes Redis, cambia CACHE_STORE=file arriba

# ============================================
# MEMCACHED (NO USADO)
# ============================================
# MEMCACHED_HOST=127.0.0.1

# ============================================
# MAIL (NO REQUERIDO PARA LA PRUEBA)
# ============================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# ============================================
# Sanctum usa configuración por defecto
# Stateful domains para desarrollo local:
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
